[Unit]
Description=Touch Bar panel recovery (rebind appletbdrm after suspend/resume)
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target multi-user.target

[Service]
Type=oneshot
# On wake the Touch Bar may not be re-enumerated yet — the rebind fails until
# it is (seen 2026-09-28 09:33, leaving a stale panel). Retry while the device
# settles. react-drm-recover also restarts react-drm afterwards (a static UI
# never re-flips frames after a rebind), whether it runs as a system or a user
# unit.
ExecStart=/bin/sh -c 'for i in 1 2 3 4 5 6; do /usr/local/sbin/react-drm-recover && exit 0; logger -t touchbar-recover "recover attempt $i failed; retrying"; sleep 3; done; exit 1'

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
